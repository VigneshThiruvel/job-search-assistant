# Adzuna API credentials (free): https://developer.adzuna.com/signup
# Leave empty to skip Adzuna during ingest.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Gmail IMAP for LinkedIn/XING job-alert emails (read-only).
# Requires 2-step verification; create an app password at
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# Optional, currently unused: Anthropic API key for `extract eval` (extraction runs via
# the MCP server + Claude Code instead). https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Neo4j (Phase 4 knowledge graph, local Docker; see docker-compose.yml).
# Pick any password (min. 8 characters); it is set on first start.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Application PDFs (Phase 7b): saved into this folder (subfolders resume/, cover_letter/)
# as <DOCUMENT_PREFIX>_resume.pdf, renamed to <company>_<posting>.pdf once you applied.
APPLICATION_DIR=~/Documents/full_time
DOCUMENT_PREFIX=firstname_lastname
