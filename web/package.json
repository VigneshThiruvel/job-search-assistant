{
  "name": "job-search-ui",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "gen:api": "uv run --quiet --project .. python -m job_search_assistant.api --openapi > openapi.json && openapi-typescript openapi.json -o src/api/schema.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "5.59.16",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.3",
    "openapi-typescript": "7.4.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
